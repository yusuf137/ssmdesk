# Copy this file to .env.local and fill in the values there.
# .env and .env.local are gitignored. Never commit real secrets.
# Never prefix the SMMFull key with NEXT_PUBLIC_.

# SMMFull — server only
SMMFULL_API_KEY=
SMMFULL_API_URL=https://smmfull.com/api/v2
SMMFULL_TIMEOUT_MS=15000

# Sale price = provider cost × multiplier, unless Firestore has a salePrice override.
# The provider cost is never sent to the browser.
SALE_PRICE_MULTIPLIER=1.5
# Role prices. Firestore pricingConfig/global overrides these when present.
# Multipliers must be between 1 and 10. SALE_PRICE_MULTIPLIER is the fallback.
USER_PRICE_MULTIPLIER=1.80
DEALER_PRICE_MULTIPLIER=1.35
# Low provider-balance warning, in the provider currency's minor units.
PROVIDER_LOW_BALANCE_THRESHOLD_MINOR=50000
# Hours to wait after a completed or rejected refill before the same order can request another.
REFILL_COOLDOWN_HOURS=24

# Firebase Admin SDK — server only. Private key may use escaped newlines.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase web API key used by the server to check email/password.
# This is not the SMMFull key. Do not expose it with NEXT_PUBLIC_.
FIREBASE_WEB_API_KEY=

# Optional Firebase web SDK config. Password login does not use these.
# Leave them empty unless a later client-side Firebase feature needs them.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Comma-separated browser origins allowed to call this app.
# The request's own origin is also accepted. Never use *.
ALLOWED_ORIGINS=http://localhost:3000

# Set to true only behind one trusted proxy that appends the peer address
# to X-Forwarded-For. Leave false to ignore spoofable forwarding headers.
TRUST_PROXY=false

# PayTR iFrame. Server only. Never prefix these with NEXT_PUBLIC_.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=true
PAYTR_NO_INSTALLMENT=0
PAYTR_MAX_INSTALLMENT=0
PAYTR_TIMEOUT_LIMIT=30
APP_BASE_URL=

# Upstash Redis REST. Required in production for centralized rate limits.
# When both are empty, development uses in-memory limits.
# Production without these values fails closed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
